+from policyengine_us.model_api import *
+
+
+class school_meal_rate_group(Variable):
+    value_type = str
+    entity = Household
+    label = "School meal reimbursement rate group"
+    definition_period = YEAR
+    documentation = (
+        "Key into the school meal reimbursement rate parameters. Guam, Puerto "
+        "Rico and the Virgin Islands use the Hawaii rates; every other state "
+        "uses its own state group."
+    )
+
+    def formula(household, period, parameters):
+        state_group = household("state_group_str", period)
+        territory = np.isin(state_group, ["GU", "PR", "VI"])
+        return np.where(territory, "HI", state_group)
